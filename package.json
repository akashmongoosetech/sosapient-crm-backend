{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "CRM backend - secure JWT auth with Express + MongoDB",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "create-admin": "node src/scripts/create-admin.js",
    "seed-user": "node src/scripts/seed-user.js",
    "lint": "eslint src tests || true"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.11.1",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "sanitize-html": "^2.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "eslint": "^9.4.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.3",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "transformIgnorePatterns": [
      "node_modules/(?!(htmlparser2|domutils|domhandler|dom-serializer|domelementtype|entities|css-select|css-what|nth-check|boolbase)/)"
    ]
  }
}
