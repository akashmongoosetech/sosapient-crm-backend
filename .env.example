NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crm
FRONTEND_ORIGIN=http://localhost:5173
# DUMMY values for local development only — replace with output from:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# before any shared/staging/production use. Never commit real secrets.
JWT_ACCESS_SECRET=dummy_dev_access_secret_change_me_32_chars_min_001
JWT_REFRESH_SECRET=dummy_dev_refresh_secret_change_me_32_chars_min_002
JWT_ISSUER=crm-api
JWT_AUDIENCE=crm-client
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_MS=604800000
COOKIE_NAME=crm_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/
ADMIN_BOOTSTRAP_SECRET=dummy_bootstrap_secret_change_me
# --- Local dev seed (seed-user.js). Local gitignored .env ONLY — never commit. ---
# SEED_PASSWORD=change_me_in_local_env_only
# --- Deal attachment storage (local disk; served only via authenticated API) ---
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=5
# MAX_FILES_PER_ENTRY=6
# FILE_TOKEN_TTL=12h  # lifespan of signed ?token= image URLs for <img> display
# Production alternative: point UPLOAD_DIR at a mounted volume or swap
# fileStorage.service.js for an S3-compatible backend (same interface).
# --- Password reset via email OTP (Brevo) ---
# BREVO_API_KEY=  # backend-only; never expose to the frontend
# Sender identity (must be verified in Brevo: sender address or authenticated domain + DNS records)
# EMAIL_FROM=info@akashraikwar.in
# EMAIL_FROM_NAME=Sosapient CRM
# APP_BASE_URL=https://your-frontend-domain.com
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# RESET_TOKEN_TTL=5m
# MAIL_DEV_VISIBLE=false  # local-only escape hatch: returns OTP in API response for testing; NEVER true in production
# --- Test database (tests/setup.js only; never used by the server) ---
# Default: tests use local MongoDB at 127.0.0.1:27017 with an isolated crm_test_<pid>_<ts>
# database (dropped after the run), falling back to mongodb-memory-server if unreachable.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
# TEST_USE_MEMORY=1  # force mongodb-memory-server even when local MongoDB is reachable
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production: COOKIE_SECURE=true, COOKIE_SAME_SITE=none (cross-site) or lax (same-site), real MONGODB_URI, HTTPS only
